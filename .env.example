# Local development uses the loopback OAuth client.
# On Render, set APP_BASE_URL to https://kelo-hub-alpha.onrender.com.
APP_BASE_URL=http://127.0.0.1:3000

# Production only: generate with `npm run gen-key` and save the JSON output
# as a secret in Render's environment settings. Never commit the real value.
ATPROTO_OAUTH_PRIVATE_KEY=
